{
  "name": "parabank-pro",
  "version": "1.0.0",
  "description": "ParaBank Pro \u2014 a realistic banking application built for Playwright automation practice",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch backend/server.ts",
    "dev:web": "vite",
    "build": "vite build && npm run build:api",
    "build:api": "esbuild backend/server.ts --bundle --platform=node --format=esm --packages=external --target=node22 --outfile=dist/server.js",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning dist/server.js",
    "seed": "tsx backend/database/reset-cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:api": "playwright test --project=api",
    "test:report": "playwright show-report",
    "challenges:generate": "tsx scripts/generate-challenge-tests.ts",
    "test:challenges": "playwright test tests/challenges"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}

# Server
PORT=4000
# SQLite database file (created automatically)
DB_PATH=./data/parabank.db
# Re-seed the canonical dataset on every start (true/false)
SEED_ON_START=false
# Set to "production" when deployed (enables Secure cookies)
NODE_ENV=development
# Allow non-HTTPS cookies even in production (e.g. plain-HTTP intranet hosting)
INSECURE_COOKIES=false

# Dev only: where Vite proxies API calls
API_URL=http://localhost:4000

# Playwright
# Run tests against an already running / deployed instance instead of starting one
# BASE_URL=https://parabank-pro.onrender.com
TEST_PORT=4100
WORKERS=1
# Skip the global "Reset Practice Data" before the suite
SKIP_RESET=false
# Use a specific Chromium binary
# CHROMIUM_PATH=/path/to/chrome
